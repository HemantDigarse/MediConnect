# PostgreSQL
POSTGRES_USER=mediconnect
POSTGRES_PASSWORD=mediconnect123

# JWT (generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-in-production

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=mediconnect-files
AWS_S3_REGION=ap-south-1

# Twilio SMS (optional — set TWILIO_ENABLED=true to activate)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# JavaMail (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend Razorpay key (same as key_id, used in Vite)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
